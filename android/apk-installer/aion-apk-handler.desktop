[Desktop Entry]
Version=1.0
Type=Application
Name=Aion APK Installer
GenericName=Android Package Installer
Comment=Install Android APKs into Waydroid with one click
Exec=/usr/bin/python3 /opt/aion/android/apk-installer/apk-handler.py %f
Icon=aion-apk-installer
Terminal=false
Categories=System;Utility;
MimeType=application/vnd.android.package-archive;
NoDisplay=true
StartupNotify=true
