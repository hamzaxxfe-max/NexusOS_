[Unit]
Description=Aion Key Mapper Daemon
Documentation=https://docs.aion.dev/key-mapper
After=waydroid-session.service
Requires=waydroid-session.service
After=graph-session.target
Wants=graph-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/aion/android/key-mapper/key-mapper-daemon.py
ExecStartPre=/bin/sleep 3
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=10

# Run as the real desktop user (via the per-user service if a graphical
# session owns it), never as root. /dev/uinput needs the input group.
User=aion-input
Group=aion-input
SupplementaryGroups=input
UMask=0077

Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/aion-input

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aion-key-mapper

# Security hardening — minimal privileges, zero network egress.
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
ProtectClock=true
ProtectHostname=true
PrivateTmp=true
PrivateDevices=no
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
NoNewPrivileges=true
CapabilityBoundingSet=
ReadWritePaths=/var/log/aion /var/lib/aion-input
ReadOnlyPaths=/dev/uinput /dev/input/uinput

# Resource limits
MemoryMax=256M
CPUQuota=50%
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=4

[Install]
WantedBy=multi-user.target
