[Unit]
Description=NexusOS Out-of-Box Experience Wizard
After=graphical.target
ConditionPathExists=!/etc/nexusos/.oobe-complete

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/share/nexusos/oobe/oobe_wizard.py
Environment=DISPLAY=:0
Restart=on-failure
User=%i
Group=%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
