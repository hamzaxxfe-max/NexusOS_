[Unit]
Description=Aion Out-of-Box Experience Wizard
After=graphical.target plasma-plasmashell.service
ConditionPathExists=!/etc/aion/.oobe-complete

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/aion/oobe/oobe_wizard.py
Restart=on-failure
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
