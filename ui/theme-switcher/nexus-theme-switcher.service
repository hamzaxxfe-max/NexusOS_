[Unit]
Description=NexusOS Theme Switcher
After=graphical.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/usr/bin/python3 /usr/lib/nexusos/theme-switcher/nexus-theme-switcher.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
