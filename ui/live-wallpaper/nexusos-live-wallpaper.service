[Unit]
Description=NexusOS Live Wallpaper Engine
After=graphical.target
Wants=graphical.target
PartOf=nexusos-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/nexusos/ui/live-wallpaper/live-wallpaper.py
Restart=always
RestartSec=5
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=HOME=%h
WorkingDirectory=/opt/nexusos/ui/live-wallpaper

[Install]
WantedBy=nexusos-session.target
