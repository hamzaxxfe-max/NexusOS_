[Unit]
Description=NexusOS Game Capture Daemon
After=graphical.target
Wants=graphical.target
PartOf=nexusos-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/nexusos/ui/game-capture/game-capture-daemon.py
Restart=always
RestartSec=5
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=HOME=%h
WorkingDirectory=/opt/nexusos/ui/game-capture

[Install]
WantedBy=nexusos-session.target
