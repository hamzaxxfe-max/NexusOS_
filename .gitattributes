# Force LF line endings for all text files (project targets Linux).
# Without this, core.autocrlf=true rewrites shell scripts to CRLF on
# checkout, breaking them on Linux.
* text=auto eol=lf

# Explicitly normalize files that are sensitive to line endings.
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.socket text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.desktop text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.cfg text eol=lf

# Binary files must never be normalized.
*.iso binary
*.qcow2 binary
*.x86_64 binary
*.zst binary
*.sig binary
*.asc binary
*.png binary
*.jpg binary
*.svg binary
*.ico binary
*.gz binary
