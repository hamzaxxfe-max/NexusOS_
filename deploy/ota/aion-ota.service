[Unit]
Description=Aion OTA Update Service
Documentation=https://aion.dev/docs/updates
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/log/aion

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/aion/ota-updater.py --check-only
ExecStart=/usr/bin/python3 /usr/lib/aion/ota-updater.py --apply
ExecStartPre=/usr/bin/mkdir -p /var/log/aion
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aion-ota
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/aion /var/lib/aion /etc/aion /tmp
NoNewPrivileges=false
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_FOWNER CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
