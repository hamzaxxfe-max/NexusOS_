[Unit]
Description=NexusOS OTA Update Service
Documentation=https://nexusos.dev/docs/updates
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/log/nexusos

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/lib/nexusos/ota-updater.py --check-only
ExecStart=/usr/bin/python3 /usr/lib/nexusos/ota-updater.py --apply
ExecStartPre=/usr/bin/mkdir -p /var/log/nexusos
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nexusos-ota
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/nexusos /var/lib/nexusos /etc/nexusos /tmp
NoNewPrivileges=false
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_FOWNER CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target
