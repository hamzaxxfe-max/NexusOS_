policy_module(aion, 1.0.0)

require {
    type userdomain;
    type unconfined_domain;
    type unconfined_t;
    type init_t;
    type initrc_t;
    type kernel_t;
    type system_u;
    type object_r;
    role system_r;
    role unconfined_r;
    class file { read open getattr execute execute_no_trans map create write unlink };
    class dir { search read getattr open };
    class chr_file { read write open getattr ioctl };
    class sock_file { read write create unlink };
    class unix_stream_socket { connectto read write };
    class process { signal sigchld setexec setpgid };
    class capability { sys_admin net_admin sys_ptrace dac_override };
    class netlink_kobject_uevent_socket { create bind read write };
    class association { create destroy };
    class tcp_socket { create bind listen accept connectto read write };
    class udp_socket { create bind read write };
    class rawip_socket { create bind read write };
    class packet_socket { create bind };
    class node { tcp_recv tcp_send udp_recv udp_send };
}

attribute aion_domain;

type aion_game_t;
type aion_game_exec_t;
type aion_game_data_t;
type aion_game_save_t;
type aion_bypass_t;
type aion_bypass_exec_t;
type aion_config_t;
type aion_untrusted_app_t;
type aion_untrusted_app_exec_t;
type aion_android_data_t;
type aion_daemon_t;
type aion_daemon_exec_t;
type aion_input_device_t;

role aion_game_r types aion_game_t;
role aion_game_r types aion_game_data_t;
role aion_game_r types aion_game_save_t;
role aion_bypass_r types aion_bypass_t;
role aion_untrusted_r types aion_untrusted_app_t;
role aion_daemon_r types aion_daemon_t;

role system_r types aion_daemon_t;
role system_r types aion_bypass_t;

type aion_home_t;
type aion_tmp_t;
type aion_gpu_device_t;
type aion_audio_device_t;

typeattribute aion_domain aion_game_t;
typeattribute aion_domain aion_untrusted_app_t;

init_domain(aion_daemon_t, aion_daemon_exec_t)
init_domain(aion_bypass_t, aion_bypass_exec_t)

domain_type(aion_game_t)
domain_type(aion_untrusted_app_t)
domain_type(aion_bypass_t)
domain_type(aion_daemon_t)

userdomain(aion_game_t, aion_game_r, system_u)
userdomain(aion_untrusted_app_t, aion_untrusted_r, system_u)
userdomain(aion_bypass_t, aion_bypass_r, system_u)

typeattr aion_domain can_execmod;

allow aion_game_t aion_game_exec_t:file { read open getattr execute execute_no_trans map };
allow aion_game_t aion_game_exec_t:dir { search read getattr open };

allow aion_game_t aion_game_data_t:dir { search read getattr open create write add_name remove_name };
allow aion_game_t aion_game_data_t:file { read write create open getattr append unlink lock ioctl map };

allow aion_game_t aion_game_save_t:dir { search read getattr open create write add_name remove_name };
allow aion_game_t aion_game_save_t:file { read write create open getattr append unlink lock map };

allow aion_game_t aion_home_t:dir { search read getattr open };
allow aion_game_t aion_home_t:file { read open getattr map };

allow aion_game_t aion_tmp_t:dir { search read getattr open create write add_name remove_name };
allow aion_game_t aion_tmp_t:file { read write create open getattr append unlink lock map };
allow aion_game_t tmp_t:dir { search read getattr open create write add_name remove_name };
allow aion_game_t tmp_t:file { read write create open getattr append unlink lock map };

allow aion_game_t aion_gpu_device_t:chr_file { read write open getattr ioctl map };
allow aion_game_t device_t:chr_file { read write open getattr ioctl map };
allow aion_game_t dri_device_t:chr_file { read write open getattr ioctl map };

allow aion_game_t aion_audio_device_t:chr_file { read write open getattr ioctl };
allow aion_game_t sound_device_t:chr_file { read write open getattr ioctl };

neverallow aion_game_t etc_t:dir { write add_name remove_name create unlink };
neverallow aion_game_t etc_t:file { write create append unlink lock };
neverallow aion_game_t usr_t:dir { write add_name remove_name create unlink };
neverallow aion_game_t usr_t:file { write create append unlink lock };
neverallow aion_game_t boot_t:dir { write add_name remove_name create unlink };
neverallow aion_game_t boot_t:file { write create append unlink lock };

allow aion_game_t aion_config_t:dir { search read getattr open };
allow aion_game_t aion_config_t:file { read open getattr map };

allow aion_game_t self:process { signal sigchld setpgid };
allow aion_game_t self:capability { sys_admin };

allow aion_game_t init_t:unix_stream_socket connectto;
allow aion_game_t init_t:process signal;

allow aion_game_t default_t:dir { search read getattr };
allow aion_game_t default_t:file { read open getattr map };

allow aion_game_t proc_t:dir { search read getattr };
allow aion_game_t proc_t:file { read open getattr map };
allow aion_game_t proc_net_t:file { read open getattr map };

allow aion_game_t port_type:tcp_socket { create bind listen accept connectto read write };
allow aion_game_t port_type:udp_socket { create bind read write };
allow aion_game_t node_t:node { tcp_recv tcp_send udp_recv udp_send };
allow aion_game_t netif_t:netif { tcp_recv tcp_send udp_recv udp_send };

allow aion_bypass_t aion_bypass_exec_t:file { read open getattr execute execute_no_trans map };
allow aion_bypass_t aion_bypass_exec_t:dir { search read getattr open };

allow aion_bypass_t aion_game_exec_t:file { read open getattr execute execute_no_trans map };
allow aion_bypass_t aion_game_exec_t:dir { search read getattr open };

allow aion_bypass_t aion_home_t:dir { search read getattr open };
allow aion_bypass_t aion_home_t:file { read write create open getattr append unlink lock map };

allow aion_bypass_t aion_tmp_t:dir { search read getattr open create write add_name remove_name };
allow aion_bypass_t aion_tmp_t:file { read write create open getattr append unlink lock map };
allow aion_bypass_t tmp_t:dir { search read getattr open create write add_name remove_name };
allow aion_bypass_t tmp_t:file { read write create open getattr append unlink lock map };

allow aion_bypass_t aion_gpu_device_t:chr_file { read write open getattr ioctl map };
allow aion_bypass_t device_t:chr_file { read write open getattr ioctl map };
allow aion_bypass_t dri_device_t:chr_file { read write open getattr ioctl map };

allow aion_bypass_t aion_audio_device_t:chr_file { read write open getattr ioctl };
allow aion_bypass_t sound_device_t:chr_file { read write open getattr ioctl };

allow aion_bypass_t aion_config_t:dir { search read getattr open };
allow aion_bypass_t aion_config_t:file { read open getattr map };

allow aion_bypass_t aion_daemon_t:unix_stream_socket connectto;
allow aion_bypass_t aion_daemon_t:process signal;

allow aion_bypass_t self:capability { sys_admin net_admin };
allow aion_bypass_t self:process { signal sigchld setexec setpgid };
allow aion_bypass_t self:capability dac_override;

allow aion_bypass_t proc_t:dir { search read getattr };
allow aion_bypass_t proc_t:file { read open getattr map };

allow aion_untrusted_app_t aion_untrusted_app_exec_t:file { read open getattr execute execute_no_trans map };
allow aion_untrusted_app_t aion_untrusted_app_exec_t:dir { search read getattr open };

allow aion_untrusted_app_t aion_android_data_t:dir { search read getattr open create write add_name remove_name };
allow aion_untrusted_app_t aion_android_data_t:file { read write create open getattr append unlink lock map };

allow aion_untrusted_app_t aion_home_t:dir { search read getattr open };
allow aion_untrusted_app_t aion_home_t:file { read open getattr map };

allow aion_untrusted_app_t aion_tmp_t:dir { search read getattr open create write add_name remove_name };
allow aion_untrusted_app_t aion_tmp_t:file { read write create open getattr append unlink lock map };
allow aion_untrusted_app_t tmp_t:dir { search read getattr open create write add_name remove_name };
allow aion_untrusted_app_t tmp_t:file { read write create open getattr append unlink lock map };

allow aion_untrusted_app_t aion_gpu_device_t:chr_file { read write open getattr ioctl map };
allow aion_untrusted_app_t device_t:chr_file { read write open getattr ioctl map };
allow aion_untrusted_app_t dri_device_t:chr_file { read write open getattr ioctl map };

allow aion_untrusted_app_t aion_audio_device_t:chr_file { read write open getattr ioctl };
allow aion_untrusted_app_t sound_device_t:chr_file { read write open getattr ioctl };

allow aion_untrusted_app_t aion_config_t:dir { search read getattr open };
allow aion_untrusted_app_t aion_config_t:file { read open getattr map };

allow aion_untrusted_app_t self:process { signal sigchld setpgid };
allow aion_untrusted_app_t self:capability { net_admin };

neverallow aion_untrusted_app_t etc_t:dir { write add_name remove_name create unlink };
neverallow aion_untrusted_app_t etc_t:file { write create append unlink lock };
neverallow aion_untrusted_app_t usr_t:dir { write add_name remove_name create unlink };
neverallow aion_untrusted_app_t usr_t:file { write create append unlink lock };
neverallow aion_untrusted_app_t boot_t:dir { write add_name remove_name create unlink };
neverallow aion_untrusted_app_t boot_t:file { write create append unlink lock };
neverallow aion_untrusted_app_t var_lib_t:dir { write add_name remove_name create unlink };
neverallow aion_untrusted_app_t var_lib_t:file { write create append unlink lock };

allow aion_daemon_t aion_daemon_exec_t:file { read open getattr execute execute_no_trans map };
allow aion_daemon_t aion_daemon_exec_t:dir { search read getattr open };

allow aion_daemon_t aion_config_t:dir { search read getattr open create write add_name remove_name };
allow aion_daemon_t aion_config_t:file { read write create open getattr append unlink };

allow aion_daemon_t aion_game_t:process { signal sigchld };
allow aion_daemon_t aion_game_t:dir { search read getattr open };
allow aion_daemon_t aion_game_t:file { read open getattr };

allow aion_daemon_t aion_bypass_t:process { signal sigchld };
allow aion_daemon_t aion_bypass_t:unix_stream_socket { connectto read write };

allow aion_daemon_t aion_untrusted_app_t:process { signal sigchld };
allow aion_daemon_t aion_untrusted_app_t:dir { search read getattr open };
allow aion_daemon_t aion_untrusted_app_t:file { read open getattr };

allow aion_daemon_t aion_input_device_t:chr_file { read write open getattr ioctl };

allow aion_daemon_t aion_tmp_t:dir { search read getattr open create write add_name remove_name };
allow aion_daemon_t aion_tmp_t:file { read write create open getattr append unlink lock map };
allow aion_daemon_t tmp_t:dir { search read getattr open create write add_name remove_name };
allow aion_daemon_t tmp_t:file { read write create open getattr append unlink lock map };

allow aion_daemon_t aion_home_t:dir { search read getattr open };
allow aion_daemon_t aion_home_t:file { read write create open getattr append unlink lock map };

allow aion_daemon_t proc_t:dir { search read getattr };
allow aion_daemon_t proc_t:file { read open getattr map };

allow aion_daemon_t self:capability { sys_admin net_admin sys_ptrace dac_override };
allow aion_daemon_t self:process { signal sigchld setexec setpgid };

allow aion_daemon_t init_t:unix_stream_socket connectto;
allow aion_daemon_t init_t:process signal;

allow aion_daemon_t port_type:tcp_socket { create bind listen accept connectto read write };
allow aion_daemon_t port_type:udp_socket { create bind read write };
allow aion_daemon_t node_t:node { tcp_recv tcp_send udp_recv udp_send };

allow aion_daemon_t aion_game_save_t:dir { search read getattr open create write add_name remove_name };
allow aion_daemon_t aion_game_save_t:file { read write create open getattr append unlink lock map };

allow aion_daemon_t aion_game_data_t:dir { search read getattr open create write add_name remove_name };
allow aion_daemon_t aion_game_data_t:file { read write create open getattr append unlink lock map };

allow aion_daemon_t aion_android_data_t:dir { search read getattr open create write add_name remove_name };
allow aion_daemon_t aion_android_data_t:file { read write create open getattr append unlink lock map };

allow aion_daemon_t kernel_t:system module_request;

allow aion_bypass_t var_log_t:dir { search read getattr open create write add_name };
allow aion_bypass_t var_log_t:file { read write create open getattr append lock };
allow aion_bypass_t aion_tmp_t:file { read write create open getattr append lock };

type aion_udev_t;
type aion_udev_exec_t;
role system_r types aion_udev_t;
init_daemon_domain(aion_udev_t, aion_udev_exec_t)

allow aion_udev_t aion_input_device_t:chr_file { read write open getattr ioctl };
allow aion_udev_t device_t:chr_file { read write open getattr ioctl };
allow aion_udev_t self:capability { sys_admin net_admin dac_override };

allow aion_daemon_t aion_udev_t:unix_stream_socket connectto;
