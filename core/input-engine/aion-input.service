[Unit]
Description=Aion Unified Input Engine
Documentation=https://aion.dev/docs/input-engine
After=multi-user.target graphical.target
Wants=graphical.target
Before=display-manager.service
ConditionPathExists=/dev/input
ConditionPathIsDirectory=/dev/input

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/lib/aion/input-engine/input-daemon.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3
StartLimitBurst=10
StartLimitIntervalSec=60

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONOPTIMIZE=1
Environment=DISPLAY=:0

User=root
Group=root
SupplementaryGroups=aion-input input
UMask=0117

ProtectSystem=strict
ProtectHome=read-only
ProtectProc=invisible
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

MemoryDenyWriteExecute=yes
LockPersonality=yes
LockMemory=yes

NoNewPrivileges=no
PrivateDevices=no
PrivateNetwork=yes
PrivateTmp=yes
PrivateUsers=no

CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID CAP_MKNOD CAP_NET_ADMIN
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID

SystemCallArchitectures=native
SystemCallFilter=~@clock @cpu-emulation @debug @mount @obsolete @reboot @swap @resources

ReadWritePaths=/var/log/aion /etc/aion /dev/input /dev/uinput
ReadOnlyPaths=/etc/aion/input-mapping.json

ExecStartPre=/bin/mkdir -p /var/log/aion
ExecStartPre=/bin/mkdir -p /run/aion

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aion-input

TimeoutStartSec=15
TimeoutStopSec=10
WatchdogSec=30

[Install]
WantedBy=multi-user.target
