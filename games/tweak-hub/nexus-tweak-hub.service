[Unit]
Description=Aion Tweak Hub
After=graphical.target
PartOf=aion-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/aion/games/tweak-hub/nexus-tweak-hub.py
Restart=on-failure
RestartSec=5
Environment=DISPLAY=:0
Environment=QT_QPA_PLATFORM=xcb
Environment=XDG_RUNTIME_DIR=/run/user/%U
WorkingDirectory=/opt/aion/games/tweak-hub

[Install]
WantedBy=aion-session.target
