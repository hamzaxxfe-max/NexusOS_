[Unit]
Description=Aion GPU Monitor Daemon
After=graphical.target
Wants=graphical.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/aion/games/tweak-hub/gpu-monitor-daemon.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
ProtectSystem=strict
ReadWritePaths=/tmp/aion-gpu-stats.json /var/log/aion
NoNewPrivileges=true

[Install]
WantedBy=graphical.target
