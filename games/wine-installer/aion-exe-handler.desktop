[Desktop Entry]
Name=Aion Wine Game Installer
Comment=Install Windows games with one click
Exec=/usr/bin/python3 /usr/lib/aion/wine-installer/wine-game-installer.py
Type=Application
Categories=Game;Utility;
Icon=application-x-executable
Terminal=false
MimeType=application/x-ms-dos-executable;application/x-ms-dos-executable;
StartupNotify=true
